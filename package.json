{
  "name": "bolo-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main/index.ts",
  "scripts": {
    "browser:setup": "playwright install chromium",
    "build": "rm -rf dist && npm run typecheck && vite build && npm run build:preload",
    "build:preload": "esbuild src/preload/index.cts --bundle --minify --platform=node --format=cjs --external:electron --outfile=dist/renderer/preload/index.cjs",
    "check": "ultracite check && npm run typecheck",
    "computer:permissions": "open -R \"bin/Bolo Desktop Control.app\"",
    "computer:setup": "zsh scripts/build-desktop-control.sh",
    "dev": "npm run build && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:preload\"",
    "dev:electron": "wait-on http://127.0.0.1:5173/app/index.html && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:preload": "esbuild src/preload/index.cts --bundle --sourcemap --platform=node --format=cjs --external:electron --outfile=dist/renderer/preload/index.cjs --watch",
    "dev:renderer": "vite --host 127.0.0.1",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "start": "npm run build && electron .",
    "test": "NODE_ENV=test vitest run",
    "test:browser-agent": "npm run build && node scripts/test-browser-agent.mjs",
    "test:browser-agent:real": "npm run build && node scripts/test-browser-agent-real-url.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/agents": "^0.15.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-stately": "^3.49.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
