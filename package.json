{
  "name": "bolo-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main/index.ts",
  "scripts": {
    "browser:setup": "playwright install chromium",
    "build": "rm -rf dist && vite build",
    "check": "ultracite check",
    "dev": "npm run build && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:renderer": "vite --host 127.0.0.1",
    "fix": "ultracite fix",
    "local-agent:permissions": "open -R \"$PWD/bin/Bolo Mac Control.app\" && open 'x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility'",
    "local-agent:setup": "zsh scripts/build-mac-control.sh",
    "prepare": "lefthook install",
    "start": "npm run build && electron .",
    "test": "NODE_ENV=test vitest run",
    "test:browser-agent": "npm run build && node scripts/test-browser-agent.mjs",
    "test:browser-agent:real": "npm run build && node scripts/test-browser-agent-real-url.mjs"
  },
  "dependencies": {
    "@openai/agents": "^0.15.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
