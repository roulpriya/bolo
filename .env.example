SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=simran
SARVAM_TTS_PACE=1.12
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-sol
OPENAI_COMPUTER_MODEL=gpt-5.6

# Jev decides whether a new typed/voice request continues the current chat.
# Without a key, Bolo asks you to choose the conversation for follow-ups.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Desktop computer_use only; browser_use keeps OPENAI_COMPUTER_MODEL above.
COMPUTER_USE_PROVIDER=openai
OPENAI_DESKTOP_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_COMPUTER_MODEL=claude-opus-5
